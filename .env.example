# NexusQuant Environment Configuration
# Copy to /opt/nexusquant/env or .env

# Upstox OAuth
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://www.jashuvatrade.xyz/api/upstox/callback

# Redis
REDIS_URL=redis://localhost:6379/0

# News — auto combines authenticated Upstox v2 instrument/position news with
# Finnhub global cues when FINNHUB_API_KEY is configured.
NEWS_PROVIDER=auto
FINNHUB_API_KEY=

# FTV probability calibration learns actual CE/PE premium outcomes from the
# retained radar tape. Scheduled events must be operator-verified JSON; the
# system never invents RBI/Fed/CPI dates.
FTV_PREMIUM_CALIBRATION_ENABLED=true
FTV_PREMIUM_CALIBRATION_HISTORY_DAYS=30
FTV_PREMIUM_CALIBRATION_SAMPLE_SECONDS=60
FTV_PREMIUM_VERTICAL_MOVE_PCT=20
FTV_PREMIUM_MIN_TRAINING_SAMPLES=200
FTV_PROBABILITY_DRIFT_WARN_PCT_POINTS=8
FTV_PROBABILITY_DRIFT_CRITICAL_PCT_POINTS=15
FTV_SCHEDULED_EVENTS_JSON=[]
FTV_SCHEDULED_EVENT_LEAD_MINUTES=30

# Keep a peak-captured CE/PE contract exhausted until it forms a fresh base
# after close and then reaccelerates; the same thresholds apply to both sides.
EXPLOSION_POST_PEAK_REENTRY_GUARD_ENABLED=true
EXPLOSION_POST_PEAK_REENTRY_LOOKBACK_SECONDS=1800
EXPLOSION_POST_PEAK_REENTRY_MIN_PEAK_POINTS=20
EXPLOSION_POST_PEAK_REENTRY_NEAR_PEAK_PCT=15
EXPLOSION_POST_PEAK_REENTRY_BASE_SAMPLES=3
EXPLOSION_POST_PEAK_REENTRY_BASE_SPAN_SECONDS=6
EXPLOSION_POST_PEAK_REENTRY_MIN_REACCELERATION_PCT=8
EXPLOSION_POST_PEAK_REENTRY_MIN_VELOCITY_3S=1.5

# Safety — production defaults
ENABLE_LIVE_TRADING=false
PAPER_TRADING=true
AUTO_TRADING_ENABLED=true
SHADOW_TRADE_ALL_SIGNALS=true

# Data cadence
MARKET_POLL_SECONDS=1
SNAPSHOT_CACHE_SECONDS=1
UPSTOX_MIN_REQUEST_INTERVAL_MS=150
UPSTOX_CHAIN_CACHE_SECONDS=15
UPSTOX_MAX_EXPIRY_PROBES=2
CAPITAL_REFRESH_SECONDS=60
BACKGROUND_MARKET_MONITOR_ENABLED=true
COMPOSER_MONITOR_ENABLED=true
CURSOR_API_KEY=

# Causal ATM/ITM pre-breakout base. Six stable past samples over 15s arm a sticky
# per-contract/session denominator; the fast launch requires positive v3/v9.
# Sparse fresh samples can instead prove sustained progress, but still require
# score, quality, orderflow, TQS, ATM/ITM, and all downstream risk gates.
FTV_ELITE_TOP_ONLY_ENABLED=true
# Rank-1 A-grade fallback requires active FTV + fresh trigger + live CVD buying/
# acceleration. Normal base extension stops at 25%; exceptional acceleration may
# extend to 40%. Both remain ordinary-sized at no more than 35% capital.
TOP_FTV_A_ENABLED=true
TOP_FTV_A_MIN_EXPLOSION_SCORE=90
TOP_FTV_A_MIN_QUALITY=70
TOP_FTV_A_MIN_TQS=50
TOP_FTV_A_MIN_VELOCITY_3S=2.5
TOP_FTV_A_MIN_VELOCITY_9S=1.75
TOP_FTV_A_NORMAL_MAX_MOVE_PCT=25
TOP_FTV_A_MAX_CAPITAL_PCT=0.35
TOP_FTV_A_EXCEPTIONAL_MIN_EXPLOSION_SCORE=95
TOP_FTV_A_EXCEPTIONAL_MIN_QUALITY=85
TOP_FTV_A_EXCEPTIONAL_MIN_TQS=55
TOP_FTV_A_EXCEPTIONAL_MIN_VELOCITY_3S=5
TOP_FTV_A_EXCEPTIONAL_MIN_VELOCITY_9S=2.5
TOP_FTV_A_EXCEPTIONAL_MAX_MOVE_PCT=40
ICT_ARMED_BASE_ENABLED=true
ICT_ARMED_BASE_LOOKBACK_SECONDS=900
ICT_ARMED_BASE_EXCLUDE_RECENT_SECONDS=3
ICT_ARMED_BASE_MIN_SAMPLES=6
ICT_ARMED_BASE_MIN_SPAN_SECONDS=15
ICT_ARMED_BASE_MAX_RANGE_PCT=5
ICT_ARMED_BASE_HORIZON_SECONDS=1800
ICT_ARMED_BASE_MIN_RATCHET_PCT=2
ICT_ARMED_BASE_LAUNCH_MIN_MOVE_PCT=5
ICT_ARMED_BASE_LAUNCH_MAX_MOVE_PCT=12
ICT_ARMED_BASE_LAUNCH_MIN_VELOCITY_3S=1.5
ICT_ARMED_BASE_LAUNCH_MIN_VELOCITY_9S=1.5
ICT_ARMED_BASE_LAUNCH_MIN_ABSOLUTE_VOLUME=25000
ICT_ARMED_BASE_LAUNCH_MIN_QUALITY=60
ICT_ARMED_BASE_LAUNCH_MIN_SCORE=45
ICT_ARMED_BASE_LAUNCH_MIN_TQS=50
ICT_ARMED_BASE_LAUNCH_RANK_BONUS=16
# Pre-authorize an exceptional rank-1 sleeve while still 2–5% above the base.
# Flat/negative tape never executes; full sizing still requires CVD + acceleration.
ICT_ELITE_BASE_READY_ENABLED=true
ICT_ELITE_BASE_READY_MIN_MOVE_PCT=2
ICT_ELITE_BASE_READY_MAX_MOVE_PCT=5
ICT_ELITE_BASE_READY_MIN_VELOCITY_3S=1.5
ICT_ELITE_BASE_READY_MIN_VELOCITY_9S=1.5
ICT_ARMED_SUSTAINED_LIFT_MIN_MOVE_PCT=8
ICT_ARMED_SUSTAINED_LIFT_MAX_MOVE_PCT=25
ICT_ARMED_SUSTAINED_LIFT_LOOKBACK_SECONDS=120
ICT_ARMED_SUSTAINED_LIFT_MIN_SAMPLES=3
ICT_ARMED_SUSTAINED_LIFT_MIN_SPAN_SECONDS=15
ICT_ARMED_SUSTAINED_LIFT_MIN_PROGRESS_PCT=3
ICT_ARMED_SUSTAINED_LIFT_MAX_FADE_PCT=2.5

# Trading mode
PAPER_SIMPLE_PROFIT_MODE=true
PAPER_DUAL_STRATEGY_ENABLED=false

# Enhanced scalping (more powerful than base)
ENHANCED_MICRO_TARGET_POINTS=2.5
ENHANCED_VELOCITY_THRESHOLD=1.2
ENHANCED_TQS_ENTRY=50
ADAPTIVE_TARGET_ENABLED=true
TICK_FUSION_ENABLED=true

# Capital — paper sizing starts with ₹2 lakh. Ordinary entries are capped at
# 35%; only a rank-1 armed launch with v3/v9 + CVD/acceleration proof may use
# the 90% sleeve. Later ranked trades use 90% of genuinely remaining capital.
FALLBACK_CAPITAL_INR=200000
MAX_SIZING_CAPITAL_INR=200000
PER_TRADE_CAPITAL_PCT=0.90
ORDINARY_ENTRY_MAX_CAPITAL_PCT=0.35
FULL_SLEEVE_REQUIRES_ARMED_LAUNCH=true
FULL_SLEEVE_REQUIRES_CVD=true
FULL_SLEEVE_REQUIRES_CVD_ACCELERATION=true
FTV_RANKED_ALLOCATION_ENABLED=true
FTV_ALLOCATION_WEIGHTS_CSV=0.60,0.25,0.10
FTV_ALLOCATION_REMAINING_PCT=0.90
FTV_ALLOCATION_CASH_RESERVE_PCT=0.0
FTV_ALLOCATION_MAX_POSITIONS=3
FTV_ALLOCATION_MAX_SAME_SIDE=2
FTV_ALLOCATION_REQUIRE_FTV=true
# Only rank-1, strict first-lift, top-tier moments may keep the full affordable
# 90% sleeve when the calculated stop exceeds the normal SL-risk budget.
TOP_RANK_FIRST_LIFT_FULL_BUDGET_LOTS_ENABLED=true
AGGRESSIVE_LOT_SIZING=true
AGGRESSIVE_MIN_TQS=50
AGGRESSIVE_MIN_EXPLOSION_SCORE=45
AGGRESSIVE_MAX_OPEN_SCALPS=3
POSITION_SL_CAP_PCT=0.02
POSITION_TP_TARGET_PCT=0.10
MAX_RISK_PER_TRADE_INR=4000
DAILY_LOSS_STOP_INR=6000
EXPLOSION_PER_TRADE_MAX_LOSS_INR=2000
EXPLOSION_EXCEPTIONAL_PER_TRADE_MAX_LOSS_INR=4000
EXPLOSION_NEVER_GREEN_STOP_POINTS=4
EXPLOSION_NEVER_GREEN_STOP_PCT=8
EXPLOSION_NEVER_GREEN_MIN_HOLD_SECONDS=10
EXPLOSION_FAILED_LAUNCH_EXIT_ENABLED=true
EXPLOSION_FAILED_LAUNCH_MIN_HOLD_SECONDS=15
EXPLOSION_FAILED_LAUNCH_MAX_HOLD_SECONDS=45
EXPLOSION_FAILED_LAUNCH_MAX_BEST_POINTS=1
EXPLOSION_FAILED_LAUNCH_MIN_LOSS_POINTS=1.5
EXPLOSION_FAILED_LAUNCH_MAX_VELOCITY_3S=0
EXPLOSION_EARLY_GREEN_LOCK_ENABLED=true
EXPLOSION_EARLY_GREEN_LOCK_MIN_BEST_POINTS=3.5
EXPLOSION_EARLY_GREEN_LOCK_BUFFER_POINTS=0.5
EXPLOSION_EARLY_GREEN_LOCK_MAX_VELOCITY_3S=0
USE_UPSTOX_CAPITAL_FOR_SIZING=true

# A structured cold base is probe-sized only; negative velocity waits for
# positive reacceleration instead of opening a trade.
ENTRY_TIMING_STRUCTURED_COLD_BASE_ALLOW=true
ENTRY_TIMING_STRUCTURED_COLD_MIN_VELOCITY_3S=0.5
ENTRY_TIMING_STRUCTURED_COLD_LOT_CAP=3
ENTRY_TIMING_STRUCTURED_COLD_MAX_LOTS=false

# Quantity per lot (units) — current NSE/BSE sizes
LOT_SIZE_NIFTY=65
LOT_SIZE_BANKNIFTY=30
LOT_SIZE_SENSEX=20
USE_UPSTOX_LOT_SIZES=false

# Hard order policy: only ATM/ITM CE and PE are executable. Shallow OTM may be
# retained in radar history so its base is available if it later rotates ATM.
TRADE_MONEYNESS_MODE=AUTO
MONEYNESS_SELECTION_ENABLED=true
MIN_OPTION_PREMIUM_INR=25
MAX_OPTION_PREMIUM_INR=100
MIN_LOTS_PER_TRADE=25
MAX_LOTS_PER_TRADE=100
SIMPLE_MAX_LOTS=100
SIMPLE_TARGET_LOTS=60
SIMPLE_MIN_LOTS=25
SWING_MIN_LOTS=25
SWING_TARGET_LOTS=75

# Persistence — every paper/live trade is appended to trades.log
TRADE_STORE_DIR=/opt/nexusquant/data/trades
# TRADE_LOG_FILE=/opt/nexusquant/data/trades/trades.log  # optional override
# Daily top-radar ZIPs default to ${TRADE_STORE_DIR}/radar_archives
RADAR_ARCHIVE_ENABLED=true
# RADAR_ARCHIVE_DIR=/opt/nexusquant/data/trades/radar_archives
RADAR_ARCHIVE_TOP_N_PER_DAY=100
RADAR_ARCHIVE_RETENTION_DAYS=365
RADAR_LEARNING_ENABLED=true
RADAR_PREMIUM_TAPE_SAMPLE_SECONDS=15
RADAR_OUTCOME_HORIZONS_SECONDS_CSV=60,300,900,1800
RADAR_OUTCOME_TARGET_PCT=20
RADAR_OUTCOME_STOP_PCT=10
RADAR_HINDSIGHT_FLAT_WINDOW_SECONDS=120
RADAR_HINDSIGHT_FLAT_MAX_RANGE_PCT=8
RADAR_HINDSIGHT_VERTICAL_MIN_MOVE_PCT=40
RADAR_HINDSIGHT_LOOKAHEAD_SECONDS=1800
RADAR_FUNNEL_DEDUPE_SECONDS=60
RADAR_HEALTH_STALE_SECONDS=45
RADAR_ARCHIVE_FINALIZE_HOUR=16
RADAR_ARCHIVE_FINALIZE_MINUTE=0
# Optional durable copy targets. S3 uses the normal AWS credential chain.
# RADAR_BACKUP_DIR=/mnt/radar-backup
# RADAR_BACKUP_S3_BUCKET=my-nexusquant-archive
RADAR_BACKUP_S3_PREFIX=nexusquant/radar
RADAR_BACKUP_RETRY_MAX=3
RADAR_BACKUP_RETRY_BASE_SECONDS=1
RADAR_BACKUP_VERIFY_HEAD=true
DAILY_TOKEN_ONCE=true

# ── Live deployment (arm only after paper validation) ──
# 1. Verify trades.log on EC2 has expected paper entries
# 2. Confirm /api/deployment/readiness returns readyForLive=true
# 3. Set below and redeploy backend:
# ENABLE_LIVE_TRADING=true
# PAPER_TRADING=false   # optional — journal still logs executionMode=LIVE

# Swing trading (multi-day paper holds)
SWING_TRADING_ENABLED=true
SWING_MAX_HOLD_DAYS=5
SWING_TARGET_PCT=30
SWING_STOP_PCT=12

COMMIT_SHA=dev
ENVIRONMENT=development
