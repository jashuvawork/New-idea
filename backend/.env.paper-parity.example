TRADE_STORE_DIR=/tmp/nexusquant/paper-parity-trades
PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
AUTO_TRADING_ENABLED=true
PAPER_LAB_USE_PROD_SNAPSHOTS=true
PAPER_LAB_PROD_API_BASE=http://65.0.136.146:8000
LAB_SESSION_TAG=parity-dev
MARKET_POLL_SECONDS=1
# Runtime Secrets on Cloud Environment (new agent after save):
# UPSTOX_API_KEY, UPSTOX_API_SECRET, UPSTOX_REDIRECT_URI, PAPER_LAB_VM_TOKEN_SYNC_KEY
# Do not commit secret values — set via Cursor secrets.
VM_UPSTOX_LOCAL_ENABLED=true