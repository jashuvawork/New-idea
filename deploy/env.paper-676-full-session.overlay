# Paper full #676 session — entry + open timing (Oct 1 class).
# Apply AFTER production.template merge; overwrites keys on EC2 env.
# Exits: pin main #816 mega TP-rung + unified 75% ladder (code defaults made explicit).

# --- Paper + #676 entry choke ---
PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
PAPER_676_ENTRY_CHOKE_ENABLED=true
OCT_PAPER_REPLICA_ENABLED=true
CALL_ATM_ITM_BASE_CAPTURE_ENABLED=true
PAPER_LIVE_PARITY_ENABLED=false
PAPER_SIMULATE_BROKER_ORDERS=false
PAPER_SLIPPAGE_ENABLED=true
LEGACY_LIVE_NARROW_STACK_ENABLED=false

# --- Open timing: first order 09:20; macro side check from 09:25 ---
# Cash-candle hold stays on from 09:15. A 09:15 macro locked the opening push
# before three closes existed (16–27 Oct, Nifty and Sensex).
ENTRY_EARLIEST_HOUR=9
ENTRY_EARLIEST_MINUTE=20
EXPLOSION_ENTRY_EARLIEST_HOUR=9
EXPLOSION_ENTRY_EARLIEST_MINUTE=20
OPEN_SIDE_CONFIRMATION_ENABLED=true
OPEN_SIDE_CONFIRMATION_START_HOUR=9
OPEN_SIDE_CONFIRMATION_START_MINUTE=25
OPEN_SIDE_CONFIRMATION_MIN_MINUTES=1
OPEN_CAUTION_UNTIL_HOUR=9
OPEN_CAUTION_UNTIL_MINUTE=45

# --- Tape from open (09:15+); #855 indicator warmup on tick overlay ---
BACKGROUND_MARKET_MONITOR_ENABLED=true

# --- Exit stack (#816): mega TP rung patience + ladder-first on best ≥55pt ---
# Stage-lock ghost-peak fix is in code (realized PnL ratchet); keep locks on.
UNIFIED_PROFIT_LADDER_ENABLED=true
UNIFIED_PROFIT_LADDER_BREAKEVEN_ENABLED=false
UNIFIED_PROFIT_LADDER_MIN_HOLD_SECONDS=180
UNIFIED_PROFIT_LADDER_MIN_SECONDS_AFTER_PEAK=180
DAILY_PROFIT_STAGE_LOCKS_ENABLED=true
TP_RUNG_LADDER_EXIT_ENABLED=true
TP_RUNG_LADDER_MIN_PROJECTED_TP=400
TP_RUNG_LADDER_MIN_BEST_TO_ARM_EXITS=28
TP_RUNG_LADDER_MIN_RUNG_POINTS=4
TP_RUNG_LADDER_MAX_RUNGS=24
TP_RUNG_LADDER_CONFIRM_SLIP_POINTS=0.25
TP_RUNG_LADDER_FLOOR_SLIP_POINTS=1.0
TP_RUNG_LADDER_FLOOR_TOUCH_POINTS=2.0
TP_RUNG_LADDER_APPROACH_BUFFER_POINTS=4
TP_RUNG_LADDER_FADE_MIN_GIVEBACK_POINTS=2
TP_RUNG_LADDER_MIN_HOLD_SECONDS=45
TP_RUNG_LADDER_HOT_DEFER_VELOCITY_3S=2.5
TP_RUNG_LADDER_RED_MIN_BEST_POINTS=20
TP_RUNG_LADDER_MEGA_FADE_MIN_GIVEBACK_POINTS=12
TP_RUNG_LADDER_MEGA_HOT_DEFER_VELOCITY_3S=4
TP_RUNG_LADDER_MEGA_APPROACH_BUFFER_POINTS=7
TP_RUNG_LADDER_MEGA_FALL_MIN_SECONDS_AFTER_PEAK=75
TP_RUNG_LADDER_MEGA_DISABLE_BETWEEN_FADE_MIN_BEST_POINTS=55
TP_RUNG_LADDER_MEGA_LADDER_FIRST_MIN_BEST_POINTS=55
