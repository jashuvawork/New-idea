# Paper full #676 session — entry + open timing (Oct 1 class).
# Apply AFTER production.template merge; overwrites keys on EC2 env.
# Exits stay on current main (adaptive / peak-keep) — no exit keys here.

# --- Paper + #676 entry choke ---
PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
PAPER_676_ENTRY_CHOKE_ENABLED=true
OCT_PAPER_REPLICA_ENABLED=true
CALL_ATM_ITM_BASE_CAPTURE_ENABLED=true
PAPER_LIVE_PARITY_ENABLED=false
PAPER_SIMULATE_BROKER_ORDERS=false
PAPER_SLIPPAGE_ENABLED=true
LEGACY_LIVE_NARROW_STACK_ENABLED=false

# --- Open timing (676): first fill ~09:16; open-side from 09:15 cash session ---
ENTRY_EARLIEST_HOUR=9
ENTRY_EARLIEST_MINUTE=16
EXPLOSION_ENTRY_EARLIEST_HOUR=9
EXPLOSION_ENTRY_EARLIEST_MINUTE=16
OPEN_SIDE_CONFIRMATION_ENABLED=true
OPEN_SIDE_CONFIRMATION_START_HOUR=9
OPEN_SIDE_CONFIRMATION_START_MINUTE=15
OPEN_SIDE_CONFIRMATION_MIN_MINUTES=1
OPEN_CAUTION_UNTIL_HOUR=9
OPEN_CAUTION_UNTIL_MINUTE=45

# --- Tape from open (09:15+); #855 indicator warmup on tick overlay ---
BACKGROUND_MARKET_MONITOR_ENABLED=true
