# ₹1.5L capital + execution defaults — RULES live in deploy/env.october-frozen.overlay.
# go-live applies october-frozen first, then this file.
#
#   sudo bash deploy/go-live-10k-monday.sh --prepare   # frozen + paper-150k via prepare path
#   LIVE_OVERLAY=deploy/env.live-150k.overlay LIVE_CAPITAL_INR=150000 \
#     sudo bash deploy/go-live-10k-monday.sh --arm-live

FALLBACK_CAPITAL_INR=150000
MAX_SIZING_CAPITAL_INR=150000

DAILY_LOSS_STOP_INR=15000
EMERGENCY_STOP_ENABLED=false
EMERGENCY_STOP_INR=15000
MAX_RISK_PER_TRADE_INR=3000
EXPLOSION_PER_TRADE_MAX_LOSS_INR=1500
EXPLOSION_EXCEPTIONAL_PER_TRADE_MAX_LOSS_INR=3000
INDEX_CONFIRMED_FTV_PER_TRADE_MAX_LOSS_INR=3000
SESSION_LARGE_LOSS_PAUSE_INR=6000
LOSS_STREAK_PAUSE_COUNT=2
DAILY_PROFIT_TARGET_FROM_CAPITAL=true
DAILY_PROFIT_TARGET_PCT=0.18

ENABLE_LIVE_TRADING=false
PAPER_TRADING=true
PAPER_SLIPPAGE_ENABLED=true
PAPER_SIMULATE_BROKER_ORDERS=true
SHADOW_TRADE_ALL_SIGNALS=true
