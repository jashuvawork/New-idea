# ₹1.5L live — same trading rules as paper (Oct 1 / 5 parity stack).
# Real Upstox orders at --arm-live; sizing book = ₹1.5L (not broker margin).
#
#   LIVE_OVERLAY=deploy/env.live-150k.overlay LIVE_CAPITAL_INR=150000 \
#     sudo bash deploy/go-live-10k-monday.sh --prepare
#   LIVE_OVERLAY=deploy/env.live-150k.overlay LIVE_CAPITAL_INR=150000 \
#     sudo bash deploy/go-live-10k-monday.sh --arm-live

# --- Capital (parity book — 75% of ₹2L overlay) ---
FALLBACK_CAPITAL_INR=150000
MAX_SIZING_CAPITAL_INR=150000
USE_UPSTOX_CAPITAL_FOR_SIZING=false
LIVE_MILESTONE_REQUIRED=false
PAPER_SIMPLE_PROFIT_MODE=true
PAPER_LIVE_PARITY_ENABLED=true

# --- Session risk (same ratios as ₹2L: ~10% daily stop, scaled per-trade caps) ---
DAILY_LOSS_STOP_INR=15000
EMERGENCY_STOP_ENABLED=false
EMERGENCY_STOP_INR=15000
MAX_RISK_PER_TRADE_INR=3000
EXPLOSION_PER_TRADE_MAX_LOSS_INR=1500
EXPLOSION_EXCEPTIONAL_PER_TRADE_MAX_LOSS_INR=3000
INDEX_CONFIRMED_FTV_PER_TRADE_MAX_LOSS_INR=3000
SESSION_LARGE_LOSS_PAUSE_INR=6000
LOSS_STREAK_PAUSE_COUNT=2
DAILY_PROFIT_TARGET_FROM_CAPITAL=true
DAILY_PROFIT_TARGET_PCT=0.18

# --- Full paper parity (no live-only selection / exit / sizing stack) ---
LIVE_PAPER_PARITY_ENABLED=true
LIVE_TRADE_SELECTION_PARITY_WITH_PAPER=true
LIVE_BEST_TRADES_ONLY_ENABLED=false
WORST_DAY_BLOCKS_LIVE=false
LIVE_DISABLE_SESSION_LIFT=false
TOP_MOMENTS_ONLY_ENABLED=false
TOP_MOMENTS_MIN_GRADE=A
FTV_ALLOCATION_MAX_POSITIONS=3
FTV_ALLOCATION_MAX_SAME_SIDE=2
LIVE_HOLD_TO_STRUCTURAL_SL=false
LIVE_EARLY_FAIL_EXIT_ENABLED=false
CHOP_LIVE_EARLY_FAIL_EXIT_ENABLED=false
LIVE_BROKER_RECONCILIATION_ENABLED=false

# Oct 1 / 5 paper rule stack (deploy/env.production.template defaults)
SEP917_LEGACY_PROFILE_ENABLED=true
SEP917_LEGACY_SKIP_PRELOSS_WORST_DAY_PAUSE=true
OTM_REVERSAL_ENTRY_ENABLED=false
INDEX_CONFIRMED_MONEYNESS_BYPASS_ENABLED=true
SEP917_LIVE_CHECKLIST_ENFORCEMENT_ENABLED=false
EXPLOSION_ONLY_TRADING_ENABLED=true
EXPLOSION_ELITE_EXPLODING_ONLY=true
LATENCY_MODE=aggressive

# Chop-live entry guards on chop days — same as paper (not extra live-only hard blocks).
CHOP_LIVE_GUARDS_ENABLED=true
CHOP_LIVE_DISABLE_SESSION_LIFT=true
CHOP_LIVE_HARD_BLOCK_WORST_DAY=true
CHOP_LIVE_BLOCK_FADED_RIP=true
CHOP_LIVE_BLOCK_EXTENDED_CHASE=true

# --- Execution mode (go-live script flips these on --arm-live) ---
ENABLE_LIVE_TRADING=false
PAPER_TRADING=true
PAPER_SLIPPAGE_ENABLED=true
PAPER_SIMULATE_BROKER_ORDERS=true
SHADOW_TRADE_ALL_SIGNALS=true
