# ₹1.5L paper book — sizing + session risk scaled to 10% of capital (same ratios as ₹2L).
# Merge onto /opt/nexusquant/env after production / Oct parity rules.
#
#   sudo PAPER_OVERLAY=deploy/env.paper-150k.overlay bash deploy/go-live-10k-monday.sh --paper
#   sudo bash deploy/set-paper-capital.sh   # default ₹1.5L after script update

FALLBACK_CAPITAL_INR=150000
MAX_SIZING_CAPITAL_INR=150000
USE_UPSTOX_CAPITAL_FOR_SIZING=false

DAILY_LOSS_STOP_INR=15000
EMERGENCY_STOP_ENABLED=false
EMERGENCY_STOP_INR=15000
MAX_RISK_PER_TRADE_INR=3000
EXPLOSION_PER_TRADE_MAX_LOSS_INR=1500
EXPLOSION_EXCEPTIONAL_PER_TRADE_MAX_LOSS_INR=3000
INDEX_CONFIRMED_FTV_PER_TRADE_MAX_LOSS_INR=3000
SESSION_LARGE_LOSS_PAUSE_INR=6000
DAILY_PROFIT_TARGET_FROM_CAPITAL=true
DAILY_PROFIT_TARGET_PCT=0.18
