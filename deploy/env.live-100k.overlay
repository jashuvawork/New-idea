# Fixed ₹1L (#758) — kept so a live arm made with it survives deploys. New arms: env.live-capital.overlay (any budget).
# Never arm live without go-live applying frozen overlay first (CE/PE Oct paper stack).
# Runbook: deploy/live-ce-pe-oct-paper-setup.md
#
#   sudo bash deploy/go-live-10k-monday.sh --prepare   # frozen + paper-150k via prepare path
#   LIVE_OVERLAY=deploy/env.live-100k.overlay LIVE_CAPITAL_INR=100000 \
#     sudo bash deploy/go-live-10k-monday.sh --arm-live
#
# Risk scaled 2/3 from env.live-150k (10% daily loss budget = ₹10k).

FALLBACK_CAPITAL_INR=100000
MAX_SIZING_CAPITAL_INR=100000

DAILY_LOSS_STOP_INR=10000
EMERGENCY_STOP_ENABLED=false
EMERGENCY_STOP_INR=10000
MAX_RISK_PER_TRADE_INR=2000
EXPLOSION_PER_TRADE_MAX_LOSS_INR=1000
EXPLOSION_EXCEPTIONAL_PER_TRADE_MAX_LOSS_INR=2000
INDEX_CONFIRMED_FTV_PER_TRADE_MAX_LOSS_INR=2000
SESSION_LARGE_LOSS_PAUSE_INR=4000
LOSS_STREAK_PAUSE_COUNT=2
DAILY_PROFIT_TARGET_FROM_CAPITAL=true
DAILY_PROFIT_TARGET_PCT=0.18

ENABLE_LIVE_TRADING=false
PAPER_TRADING=true
PAPER_SLIPPAGE_ENABLED=true
PAPER_SIMULATE_BROKER_ORDERS=true
SHADOW_TRADE_ALL_SIGNALS=true
