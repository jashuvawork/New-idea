# ₹2L live capital overlay — merge onto /opt/nexusquant/env before session open (IST).
# Matches Upstox margin + trading ceiling at ₹200,000. Arm with:
#   sudo bash deploy/go-live-10k-monday.sh --arm-live
# (script defaults to this overlay and LIVE_CAPITAL_INR=200000)
#
# Risk stack: 10% daily budget (₹20k stop), same live-best-trades bar as small-cap path
# but full production lot sizing (~90% sleeve on rank-1 ELITE).

# --- Capital (sizing ceiling; Upstox margin capped here when live) ---
FALLBACK_CAPITAL_INR=200000
MAX_SIZING_CAPITAL_INR=200000
USE_UPSTOX_CAPITAL_FOR_SIZING=true

# Operator live — skip 50-trade paper milestone gate.
LIVE_MILESTONE_REQUIRED=false

# --- Session / trade loss limits (10% daily budget = ₹20k) ---
DAILY_LOSS_STOP_INR=20000
EMERGENCY_STOP_ENABLED=false
EMERGENCY_STOP_INR=20000
MAX_RISK_PER_TRADE_INR=4000
EXPLOSION_PER_TRADE_MAX_LOSS_INR=2000
EXPLOSION_EXCEPTIONAL_PER_TRADE_MAX_LOSS_INR=4000
INDEX_CONFIRMED_FTV_PER_TRADE_MAX_LOSS_INR=4000
SESSION_LARGE_LOSS_PAUSE_INR=8000
LIVE_HOLD_TO_STRUCTURAL_SL=true
CHOP_LIVE_GUARDS_ENABLED=true
CHOP_LIVE_EARLY_FAIL_EXIT_ENABLED=true
CHOP_LIVE_DISABLE_SESSION_LIFT=true
CHOP_LIVE_HARD_BLOCK_WORST_DAY=true
CHOP_LIVE_BLOCK_FADED_RIP=true
CHOP_LIVE_BLOCK_EXTENDED_CHASE=true
LIVE_BROKER_RECONCILIATION_ENABLED=true

# --- Live best-trades-only (real money: grade S, one position, pause after loss) ---
TOP_MOMENTS_MIN_GRADE=S
LIVE_BEST_TRADES_ONLY_ENABLED=true
LIVE_BEST_TRADES_MIN_GRADE=S
LIVE_BEST_TRADES_MIN_EXPLOSION_SCORE=200
LIVE_BEST_TRADES_REQUIRE_FIRST_LIFT=true
LIVE_BEST_TRADES_MIN_LOCAL_BASE_PCT=15
LIVE_BEST_TRADES_REQUIRE_CHART_ALIGNED=true
LIVE_MAX_OPEN_POSITIONS=1
LIVE_MAX_SAME_SIDE_POSITIONS=1
LIVE_PAUSE_AFTER_SESSION_LOSSES=1
LIVE_DISABLE_SESSION_LIFT=true
LIVE_EARLY_FAIL_EXIT_ENABLED=true
FTV_ALLOCATION_MAX_POSITIONS=1
FTV_ALLOCATION_MAX_SAME_SIDE=1
LOSS_STREAK_PAUSE_COUNT=1

# Daily profit target follows capital (18% → ₹36k/day)
DAILY_PROFIT_TARGET_FROM_CAPITAL=true
DAILY_PROFIT_TARGET_PCT=0.18

# --- Live execution (go-live script sets ENABLE_LIVE_TRADING=true at arm) ---
ENABLE_LIVE_TRADING=false
PAPER_TRADING=true
PAPER_SLIPPAGE_ENABLED=true
PAPER_SIMULATE_BROKER_ORDERS=true
SHADOW_TRADE_ALL_SIGNALS=true
