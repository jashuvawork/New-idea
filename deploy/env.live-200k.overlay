# ₹2L live — same trading rules as paper (Oct 1 / 5 + #682–#684). Only difference at arm:
# real Upstox orders instead of simulated fills. Arm: deploy/go-live-10k-monday.sh --arm-live

# --- Capital (matches paper ₹2L book) ---
FALLBACK_CAPITAL_INR=200000
MAX_SIZING_CAPITAL_INR=200000
USE_UPSTOX_CAPITAL_FOR_SIZING=true
LIVE_MILESTONE_REQUIRED=false

# --- Session risk (same as deploy/env.production.template / paper) ---
DAILY_LOSS_STOP_INR=20000
EMERGENCY_STOP_ENABLED=false
EMERGENCY_STOP_INR=20000
MAX_RISK_PER_TRADE_INR=4000
EXPLOSION_PER_TRADE_MAX_LOSS_INR=2000
EXPLOSION_EXCEPTIONAL_PER_TRADE_MAX_LOSS_INR=4000
INDEX_CONFIRMED_FTV_PER_TRADE_MAX_LOSS_INR=4000
SESSION_LARGE_LOSS_PAUSE_INR=8000
LOSS_STREAK_PAUSE_COUNT=2
DAILY_PROFIT_TARGET_FROM_CAPITAL=true
DAILY_PROFIT_TARGET_PCT=0.18

# --- Full paper parity (no live-only selection / exit / sizing stack) ---
LIVE_PAPER_PARITY_ENABLED=true
LIVE_TRADE_SELECTION_PARITY_WITH_PAPER=true
LIVE_BEST_TRADES_ONLY_ENABLED=false
WORST_DAY_BLOCKS_LIVE=false
TOP_MOMENTS_MIN_GRADE=A
FTV_ALLOCATION_MAX_POSITIONS=3
FTV_ALLOCATION_MAX_SAME_SIDE=2
LIVE_HOLD_TO_STRUCTURAL_SL=false
LIVE_EARLY_FAIL_EXIT_ENABLED=false
CHOP_LIVE_EARLY_FAIL_EXIT_ENABLED=false
LIVE_BROKER_RECONCILIATION_ENABLED=false

# Chop-live entry guards on chop days — same as paper (not extra live-only hard blocks).
CHOP_LIVE_GUARDS_ENABLED=true
CHOP_LIVE_DISABLE_SESSION_LIFT=true
CHOP_LIVE_HARD_BLOCK_WORST_DAY=true
CHOP_LIVE_BLOCK_FADED_RIP=true
CHOP_LIVE_BLOCK_EXTENDED_CHASE=true

# --- Execution mode (go-live script flips these on --arm-live) ---
ENABLE_LIVE_TRADING=false
PAPER_TRADING=true
PAPER_SLIPPAGE_ENABLED=true
PAPER_SIMULATE_BROKER_ORDERS=true
SHADOW_TRADE_ALL_SIGNALS=true
