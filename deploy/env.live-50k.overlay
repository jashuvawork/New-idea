# ₹50k capital + execution defaults — RULES ONLY in deploy/env.october-frozen.overlay.
# Runbook: deploy/live-ce-pe-oct-paper-setup.md
#
#   sudo bash deploy/go-live-10k-monday.sh --prepare \
#     PAPER_OVERLAY=deploy/env.paper-50k.overlay PAPER_CAPITAL_INR=50000
#   LIVE_OVERLAY=deploy/env.live-50k.overlay LIVE_CAPITAL_INR=50000 \
#     sudo bash deploy/go-live-10k-monday.sh --arm-live
#
# Risk scaled ~1/3 from env.live-150k (10% daily loss budget = ₹5k).

FALLBACK_CAPITAL_INR=50000
MAX_SIZING_CAPITAL_INR=50000

DAILY_LOSS_STOP_INR=5000
EMERGENCY_STOP_ENABLED=false
EMERGENCY_STOP_INR=5000
MAX_RISK_PER_TRADE_INR=1000
EXPLOSION_PER_TRADE_MAX_LOSS_INR=500
EXPLOSION_EXCEPTIONAL_PER_TRADE_MAX_LOSS_INR=1000
INDEX_CONFIRMED_FTV_PER_TRADE_MAX_LOSS_INR=1000
SESSION_LARGE_LOSS_PAUSE_INR=2000
LOSS_STREAK_PAUSE_COUNT=2
DAILY_PROFIT_TARGET_FROM_CAPITAL=true
DAILY_PROFIT_TARGET_PCT=0.18

ENABLE_LIVE_TRADING=false
PAPER_TRADING=true
PAPER_SLIPPAGE_ENABLED=true
PAPER_SIMULATE_BROKER_ORDERS=true
SHADOW_TRADE_ALL_SIGNALS=true
