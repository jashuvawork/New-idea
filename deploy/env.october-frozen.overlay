# Frozen October — symmetric CE/PE Oct 1 paper stack (RULES ONLY).
# Do not edit for one-off sessions; change capital via env.paper-150k / env.live-150k.
# Merge order on EC2: production.template → this file → capital overlay.
#
# Marker for HUD: october_frozen_profile_ok()

OCTOBER_FROZEN_PROFILE_ENABLED=true

# --- Same-day CE + PE best moments (no sticky one-side book) ---
SYMMETRIC_BEST_TRADE_CAPTURE_ENABLED=true
DIRECTIONAL_SIDE_LOCK_ENABLED=true
INDEX_RALLY_SIDE_FLIP_ENABLED=true
BEST_TRADE_BASE_FIRST_ENABLED=true
BEST_TRADE_SEP917_BASE_SHAPE_ALIGN_ENABLED=true
FTV_ALLOCATION_MAX_POSITIONS=3
FTV_ALLOCATION_MAX_SAME_SIDE=2
# Best-only + one opposite-side leg while a side is open (CE and PE momentum at once).
# First leg keeps SELECTOR_BEST_ONLY_DUAL_SIDE_RESERVE_PCT (default 0.30) of capital free.
SELECTOR_BEST_ONLY_DUAL_SIDE_ENABLED=true
# Open legs tie up their entry cost only — a CE/PE winner's mark never starves the opposite leg.
CAPITAL_COMMIT_AT_ENTRY_COST_ENABLED=true
# CE win -> PE mirror / PE win -> CE mirror arm on any trail win >= 0.2% of capital
MIRROR_WIN_MIN_CAPITAL_PCT=0.002
MIRROR_WIN_MIN_FLOOR_INR=250

# --- Oct 1 / Oct 5 paper replica: radar + selection + entry as those sessions ran ---
# Off: post-Oct 5 parity waivers (#718+), pad guard (#699/#701/#707), ₹18–350 radar
# band (#714), strict ATM/ITM-only execution (#692). Exits stay current (peak-keep,
# adaptive SL, N×/k× fast fade, maxProfitCapture). Daily loss / streak stops unchanged.
OCT_PAPER_REPLICA_ENABLED=true

# --- Sep917 / Oct paper selection (ATM/ITM, no cheap OTM stack) ---
SEP917_LEGACY_PROFILE_ENABLED=true
SEP917_LEGACY_SKIP_PRELOSS_WORST_DAY_PAUSE=true
SEP917_LIVE_CHECKLIST_ENFORCEMENT_ENABLED=false
BEST_TRADE_CHEAP_BASE_RANK_PRIORITY_ENABLED=false
EXPLOSION_SHALLOW_OTM_ENTRY_ENABLED=false
OTM_REVERSAL_ENTRY_ENABLED=true
EXPLOSION_ONLY_TRADING_ENABLED=true
EXPLOSION_ELITE_EXPLODING_ONLY=true
INDEX_CONFIRMED_MONEYNESS_BYPASS_ENABLED=true

# Oct 1 / Oct 5 paper: expiry worst-day declining session halts entries.
EXPIRY_WORST_DAY_HALT_ENTRIES=true
# Slide/rally ITM rip may exceed ₹350 cap (still ATM/ITM; deep OTM blocked).
OCT_PAPER_SLIDE_EXPLOSION_MAX_PREMIUM_INR=650
OCT_PAPER_SLIDE_PREMIUM_WAIVER_ENABLED=true
OCT_PAPER_FIRST_LIFT_SMALL_LIFT_WAIVER_ENABLED=true
OCT_PAPER_OPEN_MOMENT_PAD_WAIVER_ENABLED=true
# Oct 1 / Oct 5 paper: first entry 09:20.
ENTRY_EARLIEST_HOUR=9
ENTRY_EARLIEST_MINUTE=20
# Open window (09:15–09:45): side confirmed by today's index tape — no first-bar entries,
# CE needs index ≥ +0.10% above open in upper 60% of range, PE the mirror (Oct 13 22300 PE).
OPEN_SIDE_CONFIRMATION_ENABLED=true
# A CE stop cools only CE, a PE stop only PE — the opposite side keeps its momentum (Oct 13).
EXPLOSION_COOLDOWN_PER_SIDE_ENABLED=true

# --- Paper ↔ live parity (no live-only narrowing) ---
LEGACY_LIVE_NARROW_STACK_ENABLED=false
LIVE_PAPER_PARITY_ENABLED=true
LIVE_TRADE_SELECTION_PARITY_WITH_PAPER=true
PAPER_LIVE_PARITY_ENABLED=true
LIVE_BEST_TRADES_ONLY_ENABLED=false
WORST_DAY_BLOCKS_LIVE=false
LIVE_DISABLE_SESSION_LIFT=false
TOP_MOMENTS_ONLY_ENABLED=false
TOP_MOMENTS_MIN_GRADE=A
LIVE_HOLD_TO_STRUCTURAL_SL=false
LIVE_EARLY_FAIL_EXIT_ENABLED=false
CHOP_LIVE_EARLY_FAIL_EXIT_ENABLED=false
LIVE_BROKER_RECONCILIATION_ENABLED=false
USE_UPSTOX_CAPITAL_FOR_SIZING=false
LIVE_MILESTONE_REQUIRED=false
PAPER_SIMPLE_PROFIT_MODE=true

# Per-trade adaptive SL/TP (live + paper parity — not fixed explosion_stop_loss)
ADAPTIVE_EXITS_ENABLED=true
EXECUTED_ENTRY_SL_ONLY_LOSS_EXITS=true

# Pad location guard (#699/#701/#707) — not on Oct 1 / Oct 5 paper; off under the replica.
LIVE_PAPER_PARITY_PAD_ENTRY_GUARD_ENABLED=false

# Chop-live: same as paper; waive near-base Sep917 shape (CE + PE)
CHOP_LIVE_GUARDS_ENABLED=true
CHOP_LIVE_DISABLE_SESSION_LIFT=true
CHOP_LIVE_HARD_BLOCK_WORST_DAY=true
CHOP_LIVE_BLOCK_FADED_RIP=true
CHOP_LIVE_BLOCK_EXTENDED_CHASE=true
CHOP_LIVE_WAIVE_NEAR_BASE_SEP917_SHAPE=true

# --- Session timing / exits (Oct 1 #679, Oct 1 PE #680-681, Oct 5 #682) ---
POWER_HOUR_END_HOUR=15
POWER_HOUR_END_MINUTE=35
DAILY_PROFIT_STAGE_BLOCK_ENTRIES_MIN_STAGE=3
EXPLOSION_MULTIPLE_FAST_FADE_ENABLED=true
# Hard stops no min-hold can defer (Oct 13 22300 PE: never green, ₹56 stop held 10 min → ₹15).
NEVER_GREEN_HARD_STOP_ENABLED=true
# 300s grace: a 5s arm cut Sep 24 SENSEX 73800 PE (-36.6pt at 77s → +388pt) and Oct 1
# 71600 PE at ~70s. Anchored replay of 19 sessions: 5s −₹11k PF 0.92, 120s +₹2.96L,
# 300s +₹3.40L PF 4.98 (same as off); remaining fires match the adaptive stop exactly.
NEVER_GREEN_HARD_STOP_MIN_HOLD_SECONDS=300
CATASTROPHIC_LOSS_STOP_PCT=30
# Oct 13 22250 CE: no breakeven shakeout while the index holds entry (CE/PE mirrored).
BREAKEVEN_SHAKEOUT_HOLD_ENABLED=true
# Oct 13 22250 CE: deep-ITM runner holds a <8% premium pullback while the index holds entry.
DEEP_ITM_RUNNER_PULLBACK_HOLD_ENABLED=true
# Oct 13 open: lagging Ichimoku cloud blocked the CE V-rip; waive it on a confirmed
# index rally off session low (CE) / slide off session high (PE).
SMART_ICHIMOKU_INDEX_RALLY_BYPASS_ENABLED=true
# Oct 14 SENSEX 72800 PE: one always-max stop (₹5.6k) overshot the ₹4.1k left of the
# daily stop. Every entry (CE/PE) is sized so its stop fits the remaining budget.
ENTRY_STOP_DAILY_BUDGET_CAP_ENABLED=true
# Unified profit ladder (BE +2% at peak ≥8%, 75% keep at ≥15%, N×/k× floor). Off until
# EOD replay on stored radar ZIPs shows capture ≥ legacy; flip to true in one PR.
UNIFIED_PROFIT_LADDER_ENABLED=false

# --- Open first rip + base-first (Sep 28 #651-656, Sep 30 #669-670) — any trading day ---
SEP09_INTENT_OPEN_PREMIUM_FIRST_RIP_WAIVE_ENABLED=true
SEP917_OPEN_PREMIUM_FIRST_RIP_WAIVE_ENABLED=true
EXPIRY_OPEN_BLOCK_WAIVE_OPEN_PREMIUM_FIRST_RIP=true
PREMIUM_VERTICAL_CHASE_BLOCK_ENABLED=true

# --- Oct 1 mirror leg / anti-chase after win (#674, #677, #678) — CE + PE symmetric ---
PE_WIN_CE_MIRROR_BLOCK_PUT_CHASE_ENABLED=true
PE_WIN_CE_MIRROR_ENABLED=true

# --- Oct 5 afternoon V-rip on same strike after morning win (#683, #684) ---
SAME_STRIKE_POST_WIN_V_RIP_REENTRY_WAIVE_ENABLED=true
ELITE_V_RIP_SHALLOW_WAIVE_SESSION_LOW_VOLUME_ENABLED=true

LATENCY_MODE=aggressive
