# Live capital that fits any daily budget — RULES ONLY in deploy/env.october-frozen.overlay.
# Never arm live without go-live applying frozen overlay first (CE/PE Oct paper stack).
# Runbook: deploy/live-ce-pe-oct-paper-setup.md
#
# No fixed capital here: go-live writes FALLBACK_CAPITAL_INR / MAX_SIZING_CAPITAL_INR from
# LIVE_CAPITAL_INR and POSTs it to /api/capital. Intraday, POST /api/capital
# {"allocatedInr": N} re-fits sizing and every limit below without a restart.
#
#   LIVE_CAPITAL_INR=120000 sudo bash deploy/go-live-10k-monday.sh --arm-live
#
# Limits as % of the day's book (₹1L → ₹10k daily stop, ₹2k/trade, ₹4k pause).

CAPITAL_SCALED_RISK_LIMITS_ENABLED=true
DAILY_LOSS_STOP_CAPITAL_PCT=10
EMERGENCY_STOP_CAPITAL_PCT=10
MAX_RISK_PER_TRADE_CAPITAL_PCT=2
SESSION_LARGE_LOSS_PAUSE_CAPITAL_PCT=4

EMERGENCY_STOP_ENABLED=false
LOSS_STREAK_PAUSE_COUNT=2
DAILY_PROFIT_TARGET_FROM_CAPITAL=true
DAILY_PROFIT_TARGET_PCT=0.18

ENABLE_LIVE_TRADING=false
PAPER_TRADING=true
PAPER_SLIPPAGE_ENABLED=true
PAPER_SIMULATE_BROKER_ORDERS=true
SHADOW_TRADE_ALL_SIGNALS=true
